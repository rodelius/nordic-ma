# Copy to .env.local and supply values securely. Never commit credentials.
# Local authenticated API writes require this token. Hosted extraction uses reviewer sign-in.
INGEST_TOKEN=
# Extraction uses Python rules; no AI_API_KEY or AI_MODEL is required or read.
# See docs/evidence-extraction.md.
# Optional web push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-team@example.com
# SQLite requires persistent local disk; not suitable for ephemeral Vercel storage.
# DATA_DIR=/absolute/path/to/persistent/data

# Stage 1 hosted pilot (server-only; do not prefix with NEXT_PUBLIC_).
# Local demo default: APP_MODE=demo. Vercel requires explicit pilot mode.
APP_MODE=demo
# Set APP_URL to the exact production HTTPS origin, with no path.
APP_URL=
SUPABASE_URL=
# Publishable key (or legacy anon key); NEVER a service-role/secret key.
SUPABASE_PUBLISHABLE_KEY=

# Stage 2: apply migration 002 before changing this from 1 to 2.
PILOT_STAGE=1
# Server worker credential: Supabase secret key (legacy service_role also works).
# Required only for source scanning and delivery; never expose in browser code.
SUPABASE_SECRET_KEY=
# General Cision RSS endpoint, verified with HTTP 200 and valid XML.
SOURCE_FEED_URL=https://news.cision.com/ListItems?format=rss
# Validation defaults: both off. Manual source scan still works for reviewers.
MONITORING_ENABLED=false
NOTIFICATIONS_ENABLED=false
# Random server-only scheduler credential, at least 32 characters.
CRON_SECRET=

# Feedback engine: apply migration 004 first, then enable in Vercel and redeploy.
# Enabling collects feedback and shows shadow suggestions; it does not activate ranking.
LEARNING_ENABLED=false

# Optional source-label window for the case-based relevance model (1–500).
# SCORING_FEEDBACK_LIMIT=500
